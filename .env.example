# ==============================================================================
# StayCraft Hotel & Room Management System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment.

# ------------------------------------------------------------------------------
# 1. Django General & Core Settings
# ------------------------------------------------------------------------------
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=django-insecure-staycraft-room-mgmt-dev-secret-key-change-in-prod-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3007

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/room_management_db
CONN_MAX_AGE=60

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=room_management_db
DOCKER_POSTGRES_PORT=5435

# ------------------------------------------------------------------------------
# 3. Email SMTP Settings (For Password Resets & Booking Confirmations)
# ------------------------------------------------------------------------------
# Option A: Mailpit (Local Development & Testing - No credentials required)
# Start via Docker: docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# Or start via docker-compose: docker compose up mailpit
# Web UI: http://localhost:8025 | Inboxes all outgoing transactional emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="StayCraft Local Dev" <noreply@staycraft.local>

# Option B: Google Gmail SMTP (Production / Real Email Testing)
# Generate App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER="your_email@gmail.com"
# SMTP_PASS="your_16_char_google_app_password"
# EMAIL_FROM="StayCraft Hotel" <your_email@gmail.com>

# Hotel Notification Recipient (Receives alerts when guests submit online bookings)
HOTEL_NOTIFICATION_EMAIL=lateradrj94@gmail.com

# ------------------------------------------------------------------------------
# 4. CORS & CSRF Settings
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3007,http://127.0.0.1:3007
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3007,http://127.0.0.1:3007

# ------------------------------------------------------------------------------
# 5. Security & SSL (Production Only)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 6. Database Seeding Flag
# ------------------------------------------------------------------------------
SEED_DATABASE=false
